<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.multi.dao.EnrollmentDAO">

    <insert id="insert" parameterType="com.multi.dto.Enrollment" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO enrollment(student_id, course_id, enrolled_at)
        VALUES (#{studentId}, #{courseId}, NOW())
    </insert>

    <delete id="delete">
        DELETE FROM enrollment
        WHERE student_id = #{studentId} AND course_id = #{courseId}
    </delete>

    <select id="findByStudentAndCourse" parameterType="com.multi.dto.Enrollment" resultType="com.multi.dto.Enrollment">
        SELECT * FROM enrollment
        WHERE student_id = #{studentId} AND course_id = #{courseId}
    </select>

    <select id="findByStudent" parameterType="long" resultType="com.multi.dto.Enrollment">
        SELECT * FROM enrollment WHERE student_id = #{studentId}
    </select>

    <select id="findByCourse" parameterType="long" resultType="com.multi.dto.Enrollment">
        SELECT * FROM enrollment WHERE course_id = #{courseId}
    </select>

</mapper>
